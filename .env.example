# OpenAI Whisper API
WHISPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 后端服务配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# FFmpeg 路径
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# 临时文件目录
TEMP_DIR=/tmp/subforge

# 上传视频存储目录
UPLOAD_DIR=/var/lib/subforge/uploads

# 日志级别与路径
LOG_LEVEL=info
LOG_FILE=/var/log/subforge/subforge.log